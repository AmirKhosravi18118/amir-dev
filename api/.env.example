# --- Required ----------------------------------------------------------
# Fail-fast: server exits non-zero if PORT is missing.
PORT=8080

# --- Storage (pick one) ------------------------------------------------
# Preferred: Postgres. Schema is auto-created on startup.
DATABASE_URL=postgres://user:pass@localhost:5432/amir_site
# Fallback if DATABASE_URL is unset (loud warning logged at startup):
STORE_FILE=/var/lib/amir-site/inquiries.jsonl

# Salt for sha256(ip + salt) anonymized IP hashes. If unset, an ephemeral
# random salt is generated per process (hashes change across restarts).
IP_SALT=change-me-long-random-string

# --- SMTP / owner notifications ----------------------------------------
# If unset, inquiries are stored with status=pending_email and retried
# every 60s in the background. Never hardcode the address in code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASS=secret
CONTACT_TO=owner@example.com

# --- AK Studio event forwarding -----------------------------------------
STUDIO_INGEST_URL=https://studio.example/ingest/amirsite
INGEST_KEY_AMIRSITE=shared-hmac-secret
# Events are POSTed with X-AK-Timestamp + X-AK-Signature =
# hex(HMAC-SHA256(key, "<timestamp>.<raw body>")). Consumers must reject
# timestamps older than 5 minutes (replay window).
